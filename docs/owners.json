{
  "version": 1,
  "purpose": "每个源文件归谁管 —— 依据「这件事由谁说了算」划分成六域，另有基础设施与入口两种角色。scripts/check-boundaries.mjs 按本表核对。",
  "domains": [
    {
      "id": "world",
      "order": 1,
      "name": "世界",
      "question": "世界本身怎么运转",
      "owns": "地图与宗门、物品与境界表、体质与地区、纪元与出生地"
    },
    {
      "id": "role",
      "order": 2,
      "name": "角色",
      "question": "人是谁、能走多远",
      "owns": "境界能力、出生条件、家人与族产、寿元与体力的承载"
    },
    {
      "id": "cause",
      "order": 3,
      "name": "因果",
      "question": "发生什么、有什么后果",
      "owns": "事件表、决策细节、故事网、境界推进、结局与日常事件"
    },
    {
      "id": "pace",
      "order": 4,
      "name": "节奏",
      "question": "时间怎么走",
      "owns": "年月推进、突破门槛与阶段、寿限、期限与调度"
    },
    {
      "id": "voice",
      "order": 5,
      "name": "表达",
      "question": "这件事怎么说",
      "owns": "人话翻译、称呼与词库、自动叙述文本"
    },
    {
      "id": "present",
      "order": 6,
      "name": "呈现",
      "question": "玩家看到什么",
      "owns": "界面、画布、地图画面、读数与控件"
    }
  ],
  "roles": {
    "infra": {
      "name": "基础设施",
      "order": 0,
      "rule": "与内容无关的技术件（随机流）。序号 0 —— 所有域的共同底座，任何域都可以依赖它；它只能依赖自己。",
      "note": "随机流是所有域的共同底座：同一个种子必须给出同一串数，谁都不许自己造。"
    },
    "entry": {
      "name": "入口",
      "rule": "把各域接起来的地方（规则入口、存档入口）。它可以依赖任何域，任何域也可以依赖它 —— 它是枢纽，不参与方向约束。",
      "note": "它只负责「接线」，不负责「内容」—— 内容写在域里。"
    }
  },
  "direction": "依赖是单向直线：⑥呈现 → ⑤表达 → ④节奏 → ③因果 → ②角色 → ①世界。序号大的可以依赖序号小的，反过来不行。",
