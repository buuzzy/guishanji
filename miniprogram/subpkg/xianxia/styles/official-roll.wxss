/* ==========================================================================
   转盘页 · 逐项对齐 1in8b.life 官方 `#roll` / `#cert`
   --------------------------------------------------------------------------
   官方结构（dist-web/zh-hans/index.html）：
     <section id="roll" class="wrap" hidden>
       <div class="roller" id="roller"> lbl / country / meta </div>
       <div class="cert" id="cert" hidden>
         <div class="band"> b + span#certNo </div>
         <div class="body">
           guilloche / lbl / h2#certName / p.story / p.certpace /
           div#certFields.fields / figure.certmap / div.odds-line /
           div.homecmp / div.certcomps
         </div>
         <div class="foot"> ghost#certCardBtn + cta#beginBtn </div>
       </div>
     </section>

   换算基准：750rpx = 375pt，即 1px(官方) = 2rpx(小程序)。
   ⚠️ 官方固定 px 里凡是以 .5 结尾的（13.5px / 12.5px）**直接写 px** ——
      rpx 折算后会被向上取整（27rpx → 14px 而不是 13.5px）。
   ========================================================================== */

/* ── 转盘态 ────────────────────────────────────────────────────────────── */

/* 官方 #roll：min-height:100%; display:grid; place-items:center; padding-block:40px
   小程序把「居中」放到外层 .roll-stage 上，高度扣掉状态栏与官方底部留白。 */
.roll-stage {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 官方 .roller：text-align:center; min-height:70vh; display:flex;
   flex-direction:column; justify-content:center */
.roller {
  min-height: 70vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  text-align: center;
}

/* 官方 .roller .country：clamp(44px, 9vw, 110px) → 手机上取下限 44px */
.roller-name {
  font-family: var(--f-display);
  font-size: 88rpx;
  font-weight: 700;
  letter-spacing: -.02em;
  line-height: 1.05;
  min-height: 1.1em;
}

/* 官方 .roller .meta：mono 13px / ink3 / margin-top 10px */
.roller-meta {
  font-family: var(--f-mono);
  font-size: 26rpx;
  color: var(--ink3);
  margin-top: 20rpx;
}

/* ── 出生登记卡（官方 .cert） ─────────────────────────────────────────── */

.cert-wrap {
  /* 官方 #roll 在 ≤700px：padding-bottom: calc(96px + env(safe-area-inset-bottom)) */
  padding-bottom: 96px;
  padding-bottom: calc(96px + env(safe-area-inset-bottom, 0px));
}

/* 官方 .cert：width:min(720px,100%); background:var(--card);
   border:1px solid var(--rule); border-radius:4px; box-shadow:var(--shadow);
   position:relative; overflow:hidden */
.cert {
  width: 100%;
  background: var(--card);
  border: 1px solid var(--rule);
  border-radius: 8rpx;
  box-shadow: var(--shadow);
  position: relative;
  overflow: hidden;
}

/* 官方 .cert .band：accent 底 / padding 12px 22px / space-between baseline / gap 12px */
.cert-band {
  background: var(--accent);
  color: var(--accent-ink);
  padding: 24rpx 44rpx;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 24rpx;
  flex-wrap: wrap;
}
.cert-band .wx-b { font-family: var(--f-display); font-size: 36rpx; font-weight: 600; }
.cert-band .wx-span { font-family: var(--f-mono); font-size: 24rpx; opacity: .85; }

/* 官方 .cert .body：padding 22px / position relative */
.cert-body {
  padding: 44rpx;
  position: relative;
}

/* 官方 .guilloche：position absolute / inset 0 / opacity .09 / pointer-events none */
.cert-guilloche {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  opacity: .09;
  pointer-events: none;
}

/* 官方 .cert h2：clamp(30px,5vw,44px) → 手机上 30px / lh 1.15 / 700 / margin 0 */
.cert-name {
  font-family: var(--f-display);
  font-size: 60rpx;
  font-weight: 700;
  margin: 0;
  line-height: 1.15;
}

/* 官方 .cert .story：margin 12px 0 18px / 16px / ink2 */
.cert-story {
  margin: 24rpx 0 36rpx;
  font-size: 32rpx;
  color: var(--ink2);
}

/* 官方 .certpace：margin 12px 0 0 / 13.5px / lh 1.6 / ink2 / word-break keep-all */
.cert-pace {
  margin: 24rpx 0 0;
  font-size: 13.5px;
  line-height: 1.6;
  color: var(--ink2);
  word-break: normal; /* ⚠ 中文断行：见 styles/sheet.wxss 的 keep-all 说明 */
}

/* ── 官方 #certFields.fields ───────────────────────────────────────────── */
/* 官方是 grid：repeat(3,minmax(0,1fr))，≤560px 变 repeat(2,...)。
   WXSS 的 grid 在 Android 内核会塌成单列 ⇒ 用 flex + 百分比宽度重建两列。 */
.fields {
  display: flex;
  flex-wrap: wrap;
  column-gap: 36rpx;
  row-gap: 28rpx;
  border-top: 1px dashed var(--rule);
  padding-top: 32rpx;
}
.fcell {
  width: calc(50% - 18rpx);
  min-width: 0;
}
/* 官方 .fields 里的 .lbl 是**行内**的（全局 .lbl 没有 display:block），
   行高由所在块的 strut 决定（15px × 1.6 = 24px）——
   所以这里必须把块级复位撤掉，否则每行少 4.8px。 */
.fcell .lbl {
  display: inline;
}
/* 官方 .fields b：display block / 15px / 600 */
.fval {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  overflow-wrap: anywhere;
}
.fval .t { font-weight: 600; }
.fval .nw {
  display: inline-block;
  max-width: 100%;
  font-weight: 600;
  word-break: keep-all;
  overflow-wrap: anywhere;
}
.fval .small { font-size: .8em; font-weight: 400; color: var(--ink3); }

/* 官方 .qdots：inline-flex / gap 3px；i 8px 圆点，on 填墨色 */
.qdots {
  display: inline-flex;
  gap: 6rpx;
  vertical-align: middle;
}
.qdot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 1px solid var(--ink3);
}
.qdot.on {
  background: var(--ink);
  border-color: var(--ink);
}

/* ── 官方 #certMapF.certmap ───────────────────────────────────────────── */
.certmap { margin: 28rpx 0 0; }
.certmap-cap {
  margin-top: 12rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--ink2);
}

/* ── 官方 #certOdds.odds-line ─────────────────────────────────────────── */
.odds-line {
  margin-top: 32rpx;
  padding: 24rpx 28rpx;
  background: var(--stamp-soft);
  border-radius: 6rpx;
  font-size: 13.5px;
  color: var(--ink);
}
.odds-line .em { font-weight: 700; }

/* ── 官方 #certHome.homecmp ───────────────────────────────────────────── */
.cert-home {
  margin-top: 20rpx;
  padding: 24rpx 28rpx;
  border: 1px dashed var(--rule);
  border-radius: 6rpx;
  font-size: 13.5px;
  color: var(--ink2);
}
.cert-home .b { color: var(--ink); }
.cert-home .nw { color: var(--ink2); }
.ch-head, .ch-row { display: flex; }
/* 官方 .homecmp th：600 / 12px / ink3 / 右对齐 / padding 0 0 6px 10px */
.ch-th {
  flex: 1 1 0;
  min-width: 0;
  font-weight: 600;
  font-size: 24rpx;
  color: var(--ink3);
  text-align: right;
  padding: 0 0 12rpx 20rpx;
}
.ch-th-first { text-align: left; padding-left: 0; }
/* 官方 .homecmp td：右对齐 / padding 4px 0 4px 10px / border-top rule2 */
.ch-td {
  flex: 1 1 0;
  min-width: 0;
  text-align: right;
  padding: 8rpx 0 8rpx 20rpx;
  border-top: 1px solid var(--rule2);
  font-variant-numeric: tabular-nums;
}
.ch-td-first { text-align: left; padding-left: 0; }
.ch-td-last { color: var(--ink); font-weight: 600; }
/* 官方 .homecmp .hguess：block / margin-top 8px / 12px / lh 1.55 / ink3 */
.ch-note {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: var(--ink3);
}

/* ── 官方 #certComps.certcomps ────────────────────────────────────────── */
.cert-comps { margin-top: 32rpx; }
.cert-comps .lbl { display: block; margin-bottom: 8rpx; }
/* 官方 .certcomps li：≤560px 单列 / padding 8px 0 / border-bottom rule2 / 13.5px */
.cc-item {
  padding: 16rpx 0;
  border-bottom: 1px solid var(--rule2);
  font-size: 13.5px;
}
/* 官方 .certcomps li 在 ≤560px 是单列 grid，gap 2px */
.cc-name { display: block; font-weight: 600; margin-bottom: 4rpx; }
.cc-meta { display: block; color: var(--ink2); }
/* 官方 .certcomps p：margin 8px 0 0 / 13px / ink3 */
.cc-note {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--ink3);
}

/* ── 官方 #cert .foot（≤700px 常驻底部条） ────────────────────────────── */
.cert-foot {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  margin: 0;
  padding: 24rpx 32rpx 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom, 0px));
  background: var(--card);
  border-top: 1px solid var(--rule);
  box-shadow: 0 -20rpx 60rpx -24rpx rgba(0, 0, 0, .25);
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  flex-wrap: nowrap;
}
/* 官方 ≤700px .cert .foot .ghost：flex 0 1 auto / nowrap 允许换行 / lh 1.2 */
.cert-foot .ghost {
  flex: 0 1 auto;
  min-width: 0;
  white-space: normal;
  line-height: 1.2;
  text-align: center;
  font-size: 30rpx;
  padding: 24rpx 20rpx;
}
/* 官方 ≤440px .cert .foot .cta：padding 14px 14px / 17px / 居中 */
.cert-foot .cta {
  flex: 1 1 auto;
  min-width: 0;
  padding: 28rpx 28rpx;
  font-size: 17px;
  justify-content: center;
  white-space: nowrap;
}

/* ── 底部条之外的两块（小程序多出来的：官方等价物见注释） ──────────────── */
.cert-after {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 40rpx 0 0;
}
.cert-after .ghost { font-size: 28rpx; padding: 18rpx 28rpx; }
/* 官方 .ctahint：13px / ink3 */
.ctahint {
  font-size: 26rpx;
  color: var(--ink3);
  text-align: center;
}

/* ── 出生卡弹层（官方 #sheet.scrim + div.dec） ─────────────────────────── */
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 50;
  opacity: 0;
  pointer-events: none;
  transition: opacity .18s ease;
}
.sheet.open { opacity: 1; pointer-events: auto; }
/* 官方 .scrim：rgba(10,18,22,.52) */
.sheet-scrim {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(10, 18, 22, .52);
}
/* 官方 div.dec：min(560px,100%) / card 底 / rule 边 / radius 4px / 大阴影 */
.sheet-panel {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: calc(100% - 32rpx);
  max-width: 1120rpx;
  background: var(--card);
  border: 1px solid var(--rule);
  border-radius: 8rpx;
  box-shadow: 0 60rpx 160rpx -40rpx rgba(0, 0, 0, .45);
  overflow: hidden;
}
/* 官方 .dec .hd：flex space-between / padding 10px 18px / mono 12px / accent */
.sheet-hd {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 36rpx;
  border-bottom: 1px solid var(--rule);
  font-family: var(--f-mono);
  font-size: 24rpx;
  color: var(--accent);
  letter-spacing: .03em;
}
/* 官方 .sheet-x：无边框 / ink2 / 13px / padding 8px 12px */
.sheet-x {
  color: var(--ink2);
  font-family: var(--f-body);
  font-size: 26rpx;
  padding: 16rpx 24rpx;
}
/* 官方 .dec .bd：padding 18px */
.sheet-bd { padding: 36rpx; }

/* ── 出生卡出图（官方「출생 카드」是 1080×1350 的图，4:5） ───────────────── */
.card-box {
  position: relative;
  width: 100%;
  margin: 0;
  padding-bottom: 125%;
  background: var(--card2);
  border-radius: 8rpx;
  overflow: hidden;
}
.card-cv {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
}
