/* 960×624 ≈ 26:17。用 padding-bottom 锁比例。 */
.map-box {
  position: relative;
  width: 100%;
  padding-bottom: 65%;
  overflow: hidden;
  border-radius: 12rpx;
  background: #F3F6F4;
}

.map-cv {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

/* 放大地图（上游 .wmap.zoomed：点「放大地图」看细节，再点恢复）。
   小程序没有 CSS transform 缩放画布 ⇒ 改成「画布放大 1.9 倍 + 容器裁切 + 居中」。 */
.map-box.zoom {
  padding-bottom: 124%;
}
.map-box.zoom .map-cv {
  width: 190%;
  height: 190%;
  left: -45%;
  top: -45%;
}
